OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
PORT=3000

# Local development example. For Railway, use the MySQL variables supplied by Railway.
DB_HOST=localhost
DB_PORT=3306
DB_USER=smart_parent
DB_PASSWORD=change_me
DB_NAME=smart_parenting
SESSION_DAYS=7

# Admin dashboard credentials. Keep these private and set strong values in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_strong_password
ADMIN_SECRET=change_this_long_random_secret
